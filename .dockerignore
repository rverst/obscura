# Keep the build context small and, more importantly, make sure no local
# library data is ever copied into an image.
.git
.gitignore
data/
*.db
*.db-wal
*.db-shm
obscurad
web/node_modules/
# web/dist is deliberately NOT ignored: the committed .gitkeep placeholder has
# to reach the Go stage, or go:embed fails before the web stage output lands.
Dockerfile
docker-compose.yml
README.md
