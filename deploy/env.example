# Copy to .env next to docker-compose.prod.yml or docker-compose.traefik.yml:
#
#   cp env.example .env

# The domain this server answers on. It must already resolve to this machine:
# the proxy (Caddy or Traefik) proves control of it to obtain a certificate,
# Traefik routes on it, and the browser derives the passkey relying party from
# it.
OBSCURA_DOMAIN=photos.example.com

# Which image to run. Pin a version rather than tracking latest if you would
# rather choose when to upgrade -- a pull can bring a schema migration with it.
#OBSCURA_IMAGE=ghcr.io/rverst/obscura:v0.1.0
